<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetSocial.Pages.MainPage"
             x:Name="OverviewPage"
             Title="Welcome">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Welcome to the Veteran's Community" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            <Label Text="Connect • Serve • Support" FontSize="18" HorizontalTextAlignment="Center"/>
            <Label Text="A trusted space for veterans and active duty service members to connect, share stories, find support, and build community." HorizontalTextAlignment="Center"/>
            <Label Text="All members are verified through ID.me to ensure a secure, veteran-only experience." FontAttributes="Italic" TextColor="Gray" HorizontalTextAlignment="Center"/>

            <BoxView HeightRequest="1" Color="#CCCCCC" Margin="0,12" />

            <VerticalStackLayout Spacing="8">
                <Label Text="What you can do here:" FontSize="20" FontAttributes="Bold"/>
                <Label Text="Rally your squad: build connections with vets across branches"/>
                <Label Text="Drop intel: share updates, wins, and lessons learned in your feed"/>
                <Label Text="Sound off in chat: real-time conversations, one-on-one or groups"/>
                <Label Text="Support the mission: donate to keep the community and app strong"/>
            </VerticalStackLayout>
            <!-- Primary action -->
            <Button Text="Get Started"
                    BackgroundColor="#4B5E2A"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="12,14"
                    SemanticProperties.Hint="Navigate to the main dashboard"
                    Clicked="OnGetStartedClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
