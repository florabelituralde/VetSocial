<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="VetSocial.Pages.StoryViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Stories">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Stories" FontSize="24" FontAttributes="Bold"/>
        <HorizontalStackLayout>
            <Frame WidthRequest="100" HeightRequest="160" BackgroundColor="#eee" CornerRadius="12"/>
            <Frame WidthRequest="100" HeightRequest="160" BackgroundColor="#ddd" CornerRadius="12"/>
            <Frame WidthRequest="100" HeightRequest="160" BackgroundColor="#ccc" CornerRadius="12"/>
        </HorizontalStackLayout>
        <Label Text="Sample stories placeholders. Hook up backend later." FontSize="12" TextColor="Gray"/>
    </VerticalStackLayout>
</ContentPage>
