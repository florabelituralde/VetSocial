<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="VetSocial.Pages.FeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Feed">
    <CollectionView x:Name="FeedList" ItemsSource="{Binding Posts}" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="12" Margin="8">
                    <VerticalStackLayout>
                        <Label Text="{Binding Author}" FontAttributes="Bold"/>
                        <Label Text="{Binding Text}"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
